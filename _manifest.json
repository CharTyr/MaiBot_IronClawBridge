{
  "manifest_version": 2,
  "id": "chartyr.ironclaw-bridge",
  "version": "1.0.0",
  "name": "IronClawBridge",
  "description": "为 Planner 提供远程自主 Agent（IronClaw on NEAR AI）异步任务委托能力：长任务、编码、联网、多步推理",
  "author": {
    "name": "CharTyr",
    "url": "https://github.com/CharTyr"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/CharTyr/MaiBot_IronClawBridge",
    "homepage": "https://github.com/CharTyr/MaiBot_IronClawBridge",
    "documentation": "https://github.com/CharTyr/MaiBot_IronClawBridge",
    "issues": "https://github.com/CharTyr/MaiBot_IronClawBridge/issues"
  },
  "host_application": {
    "min_version": "1.0.12",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.proactive.trigger",
    "maisaka.context.append",
    "message.get_recent",
    "send.text",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "bot"
    }
  }
}
